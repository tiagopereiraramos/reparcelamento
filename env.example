# ============================================
# TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no repositório!

# ============================================
# GOOGLE SHEETS
# ============================================
# ID da planilha Base de Cálculo (encontre na URL)
PLANILHA_CALCULO_ID=seu_id_da_planilha_aqui

# ID da planilha Base de Apoio (encontre na URL)
PLANILHA_APOIO_ID=seu_id_da_planilha_apoio_aqui

# ID da planilha de teste/homologação (opcional)
PLANILHA_TESTE_HOM=seu_id_teste_aqui

# Caminho para o arquivo JSON de credenciais do Google
# Coloque o arquivo em credentials/ e ajuste o caminho
GOOGLE_CREDENTIALS_PATH=./credentials/gspread-459713-aab8a657f9b0.json

# ============================================
# SIENGE
# ============================================
# URL do sistema Sienge (geralmente não precisa alterar)
SIENGE_URL=https://jmservicos.sienge.com.br/sienge/8/index.html

# Usuário do Sienge
SIENGE_USUARIO=seu_usuario@sienge.com.br

# Senha do Sienge
SIENGE_SENHA=sua_senha_aqui

# Código da empresa no Sienge (geralmente "1")
SIENGE_EMPRESA=1

# ============================================
# SICREDI (configurar para cada empresa)
# ============================================
# URL do Sicredi (geralmente não precisa alterar)
SICREDI_URL=https://www.sicredi.com.br/home/

# Empresa 1
SICREDI_CNPJ_1=12345678000190
SICREDI_USUARIO_1=seu_usuario_empresa_1
SICREDI_SENHA_1=senha_empresa_1

# Empresa 2 (adicione mais conforme necessário)
# SICREDI_CNPJ_2=98765432000110
# SICREDI_USUARIO_2=seu_usuario_empresa_2
# SICREDI_SENHA_2=senha_empresa_2

# Empresa 3 (adicione mais conforme necessário)
# SICREDI_CNPJ_3=11122233000144
# SICREDI_USUARIO_3=seu_usuario_empresa_3
# SICREDI_SENHA_3=senha_empresa_3

# ============================================
# SENDGRID (Notificações por E-mail)
# ============================================
# API Key do SendGrid para envio de e-mails
SENDGRID_API_KEY=sua_chave_sendgrid_aqui

# E-mail remetente (deve estar verificado no SendGrid)
SENDGRID_FROM_EMAIL=seu_email@dominio.com.br

# E-mail destinatário para notificações
SENDGRID_TO_EMAIL=destinatario@dominio.com.br

# ============================================
# CONFIGURAÇÕES DE NAVEGADOR
# ============================================
# Modo headless (1 = sem interface gráfica, 0 = com interface)
# Recomendado: 1 para produção, 0 para debug
HEADLESS=1

# Caminho do perfil Firefox (opcional, deixe vazio para usar padrão)
FIREFOX_PROFILE_PATH=

# Caminho do perfil Chrome (opcional, deixe vazio para usar padrão)
CHROME_PROFILE_PATH=

# Pasta de downloads do RPA (será criada automaticamente)
# Linux/macOS: será criada em ~/Downloads/RPA_DOWNLOADS
# Windows: será criada em C:\Users\<usuario>\Downloads\RPA_DOWNLOADS
RPA_DOWNLOADS_FOLDER=RPA_DOWNLOADS

# ============================================
# CONFIGURAÇÕES DE LOG E DEBUG
# ============================================
# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Diretório de logs (relativo à raiz do projeto)
LOG_DIR=logs

# ============================================
# CONFIGURAÇÕES AVANÇADAS (Opcional)
# ============================================
# Timeout padrão para operações do navegador (segundos)
BROWSER_TIMEOUT=30

# Número de tentativas em caso de falha
MAX_RETRIES=3

# Intervalo entre tentativas (segundos)
RETRY_DELAY=5

# ============================================
# MONGODB (Opcional - se usar MongoDB)
# ============================================
# MongoDB connection string (deixe vazio se usar apenas JSON)
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DATABASE=reparcelamento

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. NUNCA commite este arquivo com valores reais
# 2. Mantenha backups seguros das credenciais
# 3. Rotacione senhas periodicamente
# 4. Use variáveis de ambiente do sistema para produção
# 5. Consulte docs/SEGURANCA_CREDENCIAIS.md para boas práticas

