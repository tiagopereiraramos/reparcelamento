# Configurações do Sistema RPA - Desenvolvedor
# Copie este arquivo para .env e configure suas credenciais

# Google Sheets (obrigatório)
GOOGLE_CREDENTIALS_PATH=./gspread-credentials.json

# IDs das Planilhas Google Sheets
PLANILHA_BASE_CALCULO_ID=1abc123...
PLANILHA_CALCULO_ID=1NTDPDEltum8X3vBHvUetCNWVEcz453FfAZGRYGmmd8U
PLANILHA_APOIO_ID=1rnOZA-CYVQmuH7b6yALNlAe6ZiztrHsrpqEyd9j6tXY
PLANILHA_INDICES_ID=1abc123...

# Sienge (opcional - para testes)
SIENGE_URL=https://sua-empresa.sienge.com.br
SIENGE_USERNAME=seu_usuario
SIENGE_PASSWORD=sua_senha

# Sicredi (opcional - para testes)  
SICREDI_URL=https://empresas.sicredi.com.br
SICREDI_USERNAME=seu_usuario
SICREDI_PASSWORD=sua_senha

# Gmail API (para notificações)
GMAIL_CREDENTIALS_PATH=./gmail-credentials.json

# MongoDB (opcional - usa JSON se não configurado)
# Para MongoDB Atlas: mongodb+srv://usuario:senha@cluster.mongodb.net/
# Para MongoDB local: mongodb://localhost:27017 (não funciona no Replit)
DATABASE_URL=mongodb+srv://seu_usuario:sua_senha@seu-cluster.mongodb.net/sistema_rpa
DATABASE_NAME=sistema_rpa

# Replit Database (nativo do Replit)
# Deixe em branco para usar o database do Replit automaticamente
DATABASE_URL=
DATABASE_NAME=sistema_rpa

# Debug
DEBUG_MODE=true
PYTHONPATH=.

# Pasta de Downloads RPA
RPA_DOWNLOADS_FOLDER=RPA_DOWNLOADS