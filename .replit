modules = ["python-3.11", "bash"]

[nix]
channel = "stable-24_05"
packages = ["firefox", "geckodriver", "glibcLocales", "libxcrypt"]

[workflows]
runButton = "Teste Sistema Completo"

[[workflows.workflow]]
name = "Teste RPA Sienge"
author = 43711956
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python executar_teste_sienge.py"

[[workflows.workflow]]
name = "Teste Sistema Completo"
author = 43711956
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python testar_sistema_completo.py"

